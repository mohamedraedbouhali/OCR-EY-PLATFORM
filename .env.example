# Default engine is the LOCAL VLM (Ollama) — no API key needed, fully offline.
# Install Ollama (https://ollama.com) and pull a vision model:
#   ollama pull qwen3-vl:4b-instruct
# (use an *-instruct tag — base qwen3-vl tags "think" and return empty output)

# Optional overrides
# OCR_ENGINE=local                        # "local" (Ollama) or "groq" (cloud)
# OLLAMA_MODEL=qwen3-vl:4b-instruct       # any vision-capable Ollama model
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192                     # context window per page; raising it forces CPU spill on small GPUs (slower)
# OCR_MAX_TOKENS=8000
# OCR_PDF_DPI=300                         # PDF raster resolution; 200 = faster, misses fine print

# Only needed for the optional Groq cloud engine (get a key free at console.groq.com)
GROQ_API_KEY=gsk_...
# OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
